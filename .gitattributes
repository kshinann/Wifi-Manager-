# Normalize text files to LF in the repo; Git still checks them out using
# the OS's native line endings unless overridden below.
* text=auto eol=lf

# Windows batch files need CRLF to run correctly.
*.bat text eol=crlf

# The Gradle wrapper shell script must stay LF (it's run under a Unix-like
# shell even from Android Studio on Windows); gradlew.bat is the Windows
# entry point and needs CRLF.
gradlew text eol=lf
gradlew.bat text eol=crlf

# Never text-normalize binaries.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.keystore binary
*.jks binary
