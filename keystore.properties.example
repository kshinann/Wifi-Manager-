## Copy this file to keystore.properties (same directory) and fill in real values.
## keystore.properties is gitignored -- never commit your real signing secrets.
##
## Generate the keystore first, if you don't already have one:
##   keytool -genkey -v -keystore release-upload-key.jks -keyalg RSA -keysize 2048 \
##     -validity 10000 -alias upload
##
## storeFile is resolved relative to the repository root.

storeFile=release-upload-key.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
