<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Only requested at runtime if the user turns on unrecognized-device alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Scan results (SSID/BSSID of nearby networks) are treated as
        location-sensitive data by the platform.
        - API < 33: requires ACCESS_FINE_LOCATION at runtime.
        - API >= 33: NEARBY_WIFI_DEVICES replaces the need for location
          permission for Wi-Fi scanning (declared WITHOUT neverForLocation
          because this app displays SSID/BSSID, which counts as derived
          location data).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        tools:targetApi="33" />

    <uses-feature
        android:name="android.hardware.wifi"
        android:required="true" />

    <application
        android:name=".WifiHealthApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WifiHealthManager">

        <!--
            AdMob App ID. This is Google's published TEST app ID (safe to ship, only ever
            serves clearly-labeled test ads); replace with your own real App ID from
            https://apps.admob.com before a production release, or ads will never seriously
            monetize. See README.md's "Ads (AdMob)" section.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WifiHealthManager"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
