<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aiguard.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/AIGuard/aiguard-agent</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Library/Application Support/AIGuard/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/AIGuard/stderr.log</string>
</dict>
</plist>
