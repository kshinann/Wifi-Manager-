{
  "manifest_version": 3,
  "name": "AI Guard",
  "version": "0.1.0",
  "description": "Reports AI tool usage to the AI Guard desktop agent and applies your organization's AI policy.",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "webNavigation", "storage", "alarms", "idle", "scripting", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_title": "AI Guard" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [{ "resources": ["blocked.html", "warn.html"], "matches": ["<all_urls>"] }]
}
