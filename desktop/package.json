{
  "name": "utube-download-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop shell for the video downloader, wrapping the bundled backend in a native window",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.utubedownload.desktop",
    "productName": "UTube Download",
    "files": ["main.js"],
    "extraResources": [
      {
        "from": "dist/",
        "to": "backend/"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "AudioVideo"
    }
  }
}
