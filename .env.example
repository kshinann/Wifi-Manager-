# Copy to .env and change every value.
POSTGRES_PASSWORD=change-me-db-password
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-long-random-string
# Encrypts recorded prompts in the database. Keep a backup: prompts cannot be read without it.
# Generate with: python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PROMPT_ENCRYPTION_KEY=change-me-base64-32-byte-key
# SaaS operator account (manages tenants). Created on first start.
PLATFORM_ADMIN_EMAIL=admin@yourcompany.com
PLATFORM_ADMIN_PASSWORD=change-me-admin-password
# true = anyone can create a tenant from the login page; false = only the platform admin creates tenants.
ALLOW_SIGNUP=false
PUBLIC_URL=https://aiguard.yourcompany.com
PORTAL_PORT=8080
